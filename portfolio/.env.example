# ---------------------------------------------------------------------------
# Backend (Express) configuration — copy to .env and adjust
# ---------------------------------------------------------------------------

# Port the Express API listens on (Vite proxies /api -> this port in dev)
PORT=8787

# Comma separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Optional: where contact submissions are stored (relative to the project root)
CONTACT_STORE_PATH=server/data/messages.json

# Optional: simple in-memory rate limit for POST /api/contact
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX=5

# ---------------------------------------------------------------------------
# Optional real email delivery / notifications (Vercel & Server)
# ---------------------------------------------------------------------------
# Option 1: Resend (Free & recommended on Vercel)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Option 2: Telegram Bot (Instant notification to your Telegram!)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_CHAT_ID=123456789

# Option 3: Standard SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# CONTACT_TO_EMAIL=nepessopyyev@gmail.com

# ---------------------------------------------------------------------------
# Frontend (Vite) configuration
# ---------------------------------------------------------------------------

# Where the dev/preview server proxies /api requests
VITE_API_TARGET=http://localhost:8787

# Leave empty to use same-origin requests through the Vite proxy / Express server
VITE_API_BASE_URL=
